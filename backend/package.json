{
  "name": "parma-rumena-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "db:migrate": "node --env-file-if-exists=.env src/db/migrate.js",
    "db:seed": "node --env-file-if-exists=.env src/db/seed.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "lint": "node --check src/app.js && node --check src/server.js && node --check src/db/index.js",
    "test": "node --test"
  },
  "dependencies": {
    "pg": "^8.23.0"
  }
}
